# Credentials. Never commit these. The 0600 mode on disk is the first line of
# defence and this file is the second; neither is a substitute for the other.
*.env
*.curl
*.token
kaggle.json
application_default_credentials.json
*.pem
service-account*.json

# Regenerated by Python
__pycache__/
*.pyc

# Raw dataset files not needed to reproduce any number in the paper.
# uci/ IS committed -- it is what explicit_specs.py and stratum_d.py read.
leakage-benchmark/memcheck_csv/
leakage-benchmark/stratc_data/
leakage-benchmark/pdfs/
leakage-benchmark/*.csv
# ...except the three intermediate result tables the paper's own tables are
# built from. These are outputs, not downloads: losing them means re-running
# the forests and the bootstrap to get them back.
!leakage-benchmark/downstream2.csv
!leakage-benchmark/confusion.csv
!leakage-benchmark/baseline10_features.csv
# ...but datasets/ is the shipped corpus, not scratch data.
!leakage-benchmark/datasets/MANIFEST.csv

# Rendered on demand by pagecount.py
*_body.pdf
.pagecount_*

# Pre-git hand snapshots. Git is the history now.
*.bak
*.bak_*

# Uncompressed sweep caches — the .gz forms are committed instead, and
# restore_caches.sh puts these back.
leakage-benchmark/hf_meta/cards.json
leakage-benchmark/kaggle_meta/full.json
leakage-benchmark/kaggle_meta/deep_index.json
leakage-benchmark/openml_meta/features.json
